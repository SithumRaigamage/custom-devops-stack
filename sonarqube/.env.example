# Copy this file to .env and fill in a real value.
# .env is gitignored — never commit real credentials.

# Password for the `sonar` PostgreSQL user, used by both the sonarqube-db
# container (POSTGRES_PASSWORD) and the sonarqube container (SONAR_JDBC_PASSWORD).
# NOTE: if ./postgresql already has an initialized database, changing this
# value alone will NOT change the DB user's actual password — Postgres only
# applies POSTGRES_PASSWORD on first init of an empty data directory. To
# rotate it on an existing database, run against the running sonarqube-db
# container:
#   docker exec -it sonarqube-db psql -U sonar -d sonar -c "ALTER USER sonar WITH PASSWORD 'new-password-here';"
# and then update this value to match.
SONARQUBE_DB_PASSWORD=change-me
SONAR_TOKEN=<your User Token>
SONAR_HOST_URL=http://localhost:9000
