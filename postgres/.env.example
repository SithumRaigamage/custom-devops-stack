# Copy to .env and edit. .env is git-ignored.
POSTGRES_CONTAINER_NAME=stack-postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postgres
# Host port (5432 is used by the dashboard's own Postgres)
POSTGRES_PORT=5433
# 127.0.0.1 = local only; 0.0.0.0 exposes to your network
POSTGRES_BIND=127.0.0.1
TZ=UTC
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_SHARED_BUFFERS=128MB
# Log statements slower than this many ms; -1 disables
POSTGRES_LOG_MIN_DURATION_MS=-1
