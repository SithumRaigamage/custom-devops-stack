# Copy to .env (git-ignored). `make bootstrap` does it and replaces every change-me.
UMAMI_APP_SECRET=change-me
UMAMI_DB_PASSWORD=change-me
UMAMI_DB_USER=umami
UMAMI_DB_NAME=umami
# The general Postgres (postgres/) through the host
UMAMI_DB_HOST=host.docker.internal
UMAMI_DB_PORT=5433
# Host port (3000 is Open WebUI, 3001 StackPilot, 3002 Grafana)
UMAMI_PORT=3004
# 127.0.0.1 = this Mac only (enough: JobTrigger sends events from its servers).
UMAMI_BIND=127.0.0.1
TZ=UTC
