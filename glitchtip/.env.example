# Copy to .env (git-ignored). `make bootstrap` does it and replaces every change-me.
GLITCHTIP_SECRET_KEY=change-me
GLITCHTIP_DB_PASSWORD=change-me
GLITCHTIP_DB_USER=glitchtip
GLITCHTIP_DB_NAME=glitchtip
# The general Postgres (postgres/) through the host
GLITCHTIP_DB_HOST=host.docker.internal
GLITCHTIP_DB_PORT=5433
# Host port (3000 Open WebUI, 3001 StackPilot, 3002 Grafana, 3004 Umami)
GLITCHTIP_PORT=3005
# 127.0.0.1 = this Mac only. For the iPhone on the LAN (JobTrigger dev builds), set
# 0.0.0.0 and GLITCHTIP_DOMAIN=http://<Mac Wi-Fi address>:3005.
GLITCHTIP_BIND=127.0.0.1
GLITCHTIP_DOMAIN=http://localhost:3005
GLITCHTIP_EMAIL_URL=smtp://stack-mailpit:1025
GLITCHTIP_FROM_EMAIL=glitchtip@devops.local
# Set to false once your account exists.
GLITCHTIP_ENABLE_REGISTRATION=true
GLITCHTIP_EVENT_DAYS=30
TZ=UTC
